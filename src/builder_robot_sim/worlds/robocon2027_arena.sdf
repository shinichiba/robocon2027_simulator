<?xml version="1.0"?>
<sdf version="1.10">

  <world name="robocon2027">

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
            
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.1 0.1 0.1 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ĐÈN GÓC 1: TRÊN - TRÁI (Tọa độ dương X, dương Y) -->
    <light name='corner_light_1' type='point'>
      <pose>4.5 4.5 5.0 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range> <!-- Tầm chiếu 15m để phủ tới tâm và rìa sân -->
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
    </light>

    <!-- ĐÈN GÓC 2: TRÊN - PHẢI (Tọa độ âm X, dương Y) -->
    <light name='corner_light_2' type='point'>
      <pose>-4.5 4.5 5.0 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
    </light>

    <!-- ĐÈN GÓC 3: DƯỚI - TRÁI (Tọa độ dương X, âm Y) -->
    <light name='corner_light_3' type='point'>
      <pose>4.5 -4.5 5.0 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
    </light>

    <!-- ĐÈN GÓC 4: DƯỚI - PHẢI (Tọa độ âm X, âm Y) -->
    <light name='corner_light_4' type='point'>
      <pose>-4.5 -4.5 5.0 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
    </light>

    <!-- ========================= -->
    <!-- ROBOTCON 2027 FIELD       -->
    <!-- ========================= -->

    <include>
      <uri>model://robocon2027_field</uri>
      <name>robocon2027_field</name>
      <pose>0 0 0 1.57079632679 0 0</pose>
    </include>

    <!-- ========================= -->
    <!-- PHYSICS GROUND             -->
    <!-- ========================= -->

    <model name="ground_collision">
      <static>true</static>

      <link name="ground">

        <collision name="ground_collision">
          <pose>0 0 -0.05 0 0 0</pose>

          <geometry>
            <box>
              <size>11.05 11.05 0.10</size>
            </box>
          </geometry>

        </collision>

      </link>
    </model>

    <!-- ========================= -->
    <!-- BR ROBOT                   -->
    <!-- ========================= -->

    <!-- <include>
      <uri>model://br_robot</uri>
      <name>BR</name>

      X=-4, Y=-4, Z=0.5
      <pose>-4 -4 0.5 0 0 0</pose>

    </include> -->

  </world>

</sdf>
