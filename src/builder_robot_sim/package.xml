<?xml version="1.0"?>
<package format="3">
  <name>builder_robot_sim</name>
  <version>0.1.0</version>
  <description>Gazebo Jetty + ROS 2 Lyrical simulation of a 600x600 mm mecanum robot for SLAM research.</description>
  <maintainer email="user@example.com">builder_robot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>robot_state_publisher</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>gz_ros2_control</depend>
  <depend>rosgraph_msgs</depend>
  <depend>nav2_map_server</depend>
  <depend>slam_toolbox</depend>
  <depend>rviz2</depend>
  <depend>xacro</depend>
  <depend>controller_manager</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>mecanum_drive_controller</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
